# Database (SQLite for local development)
# Hosting: set this in the platform env. Render runtime uses file:/var/data/prod.db
# Build-time fallback (when unset): file:./prisma/dev.db
DATABASE_URL="file:./dev.db"

# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication — generate a long random string for production
# Example: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# CORS / CSRF — comma-separated trusted origins
CORS_ALLOWED_ORIGINS="http://localhost:3000"
CSRF_TRUSTED_ORIGINS="http://localhost:3000"

# Email (development uses the console backend; production SMTP is configured later)
EMAIL_BACKEND="console"
EMAIL_FROM="Busa Mekene Eyasus Church <noreply@busamekeneeyasus.org>"

# Seed super administrator (development only — never commit real production credentials)
SEED_SUPER_ADMIN_EMAIL="admin@busamekeneeyasus.org"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!Admin1"
SEED_SUPER_ADMIN_NAME="Church Administrator"

# Optional prayer-form CAPTCHA (leave unset to skip)
# PRAYER_CAPTCHA_PROVIDER="none"
# PRAYER_CAPTCHA_SECRET=""
# NEXT_PUBLIC_PRAYER_CAPTCHA_SITE_KEY=""

# Payments / giving (never commit live merchant secrets)
# PAYMENT_PROVIDER: manual | signed_dev | ethiopia_ready | chapa | telebirr
PAYMENT_PROVIDER="manual"
# PAYMENT_WEBHOOK_SECRET=""
# PAYMENT_MERCHANT_ID=""
# PAYMENT_API_KEY=""

# Communications / Telegram / SMS (server-only — never expose in frontend)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# SMS_PROVIDER_API_KEY=""
# SMS_FROM=""
# SMS_PROVIDER_URL=""
# EMAIL_WEBHOOK_SECRET=""
# SMS_WEBHOOK_SECRET=""
# TELEGRAM_WEBHOOK_SECRET=""
# EVENT_REMINDER_OFFSETS_MINUTES=10080,4320,1440,60

# Media library (Phase 18 — server-only)
# MEDIA_SIGNING_SECRET=""
# YOUTUBE_API_KEY=""

