enum AppNotificationType {
  announcement
  news
  notice
  event_reminder
  ministry_update
  membership_update
  attendance_notice
  giving_notification
  system
}

enum NotificationChannel {
  in_app
  email
  telegram
  social
  sms
}

enum DeliveryStatus {
  pending
  queued
  sent
  delivered
  failed
  cancelled
}

enum CommunicationJobStatus {
  pending
  queued
  processing
  completed
  failed
  cancelled
}

model AppNotification {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AppNotificationType @default(system)
  title          String
  message        String
  data           String?
  relatedUrl     String?
  readAt         DateTime?
  expiresAt      DateTime?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())

  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@index([type])
  @@index([expiresAt])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAnnouncements   Boolean  @default(true)
  emailEvents          Boolean  @default(true)
  emailMinistry        Boolean  @default(true)
  emailMarketing       Boolean  @default(false)
  inAppGeneral         Boolean  @default(true)
  inAppEvents          Boolean  @default(true)
  inAppMembership      Boolean  @default(true)
  telegramEnabled      Boolean  @default(false)
  smsEnabled           Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model CommunicationJob {
  id              String                  @id @default(cuid())
  type            String
  status          CommunicationJobStatus  @default(pending)
  audience        AnnouncementAudience    @default(everyone)
  ministryId      String?
  ministry        Ministry?               @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  eventId         String?
  event           Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  announcementId  String?
  announcement    Announcement?           @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  payload         String
  channels        String                  @default("in_app")
  priority        String                  @default("normal") // normal | important | urgent | emergency
  templateId      String?
  template        CommunicationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recurrenceRule  String?
  recurrenceUntil DateTime?
  scheduledAt     DateTime?
  processedAt     DateTime?
  attemptCount    Int                     @default(0)
  maxAttempts     Int                     @default(5)
  nextRetryAt     DateTime?
  lastError       String?
  idempotencyKey  String?                 @unique
  createdById     String?
  createdBy       User?                   @relation("CommunicationJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  deliveries NotificationDelivery[]

  @@index([status])
  @@index([scheduledAt])
  @@index([nextRetryAt])
  @@index([type])
  @@index([createdById])
  @@index([priority])
  @@index([templateId])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  notificationId    String?
  notification      AppNotification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  jobId             String?
  job               CommunicationJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  userId            String?
  channel           NotificationChannel
  status            DeliveryStatus      @default(pending)
  providerReference String?
  errorCode         String?
  attemptCount      Int                 @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  idempotencyKey    String              @unique
  createdById       String?
  createdBy         User?               @relation("NotificationDeliveryActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([notificationId])
  @@index([jobId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

