/// ============================================================
/// Busa Mekene Eyasus Church - Database Schema
/// Phase 1: Foundation models
/// Phase 4: Church Information & Content Management
/// Phase 6: Authentication, accounts, and RBAC
/// Phase 7: Administration dashboard, leadership, and ministries
/// Phase 8: Content Management System
/// Phase 9–10: Sermons and Events
/// Phase 11: Prayer Request & Prayer Ministry
/// Phase 12: Church Gallery & Media Library
/// Phase 13: Church Membership & Member Management
/// Phase 14: Church Attendance & Check-in
/// Phase 15: Church Donations, Tithes & Offering Management
/// Phase 16: Church Communication & Notification System
/// Phase 17: Church Events Registration, Calendar & Waitlist
/// Phase 18: Sermons, Bible Study & Digital Media Library
/// Phase 19: Church Membership & Pastoral Care Management
/// Phase 20: Church Finance, Donations & Financial Administration
/// Phase 21: Church Staff, Volunteers & Ministry Management
/// Phase 22: Church Events, Services & Advanced Scheduling
/// Phase 23: Church Member & Family Management
/// Phase 24: Church Communication, Messaging & Notification Center
/// Phase 25: Church Content Management System (CMS extensions)
/// Phase 26: Sermon, Media & Digital Library Platform
/// Phase 27: Online Church Services, Live Streaming & Virtual Worship
/// Phase 28: Online Giving, Donations & Financial Management
/// Phase 29: Church Members Portal & Mobile Experience
/// Phase 33: Volunteer & Workforce Management
/// Phase 34: Church Administration & Governance
/// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Phase 6: Authentication, Users, Roles & Permissions
// ============================================================

enum AccountStatus {
  pending
  active
  suspended
  deactivated
}

enum AuthTokenType {
  email_verification
  password_reset
  email_change
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  profileImage String?
  status       AccountStatus @default(pending)
  isVerified   Boolean       @default(false)
  pendingEmail String?
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Future Member Management phase: User ── MemberProfile (existing Member model)
  member         Member?
  membershipApplications MembershipApplication[] @relation("MembershipApplicant")
  reviewedApplications   MembershipApplication[] @relation("MembershipReviewer")
  membershipHistory      MembershipStatusHistory[] @relation("MembershipHistoryActor")
  auditLogs               AuditLog[]
  prayerRequests          PrayerRequest[]     @relation("PrayerRequester")
  assignedPrayerRequests  PrayerRequest[]     @relation("PrayerAssignee")
  prayerNotes             PrayerNote[]        @relation("PrayerNoteAuthor")
  contributions           Contribution[] @relation("ContributionDonor")
  contributionsRecorded   Contribution[] @relation("ContributionRecorder")
  contributionRefunds     ContributionRefund[] @relation("ContributionRefundActor")
  donationCampaignsCreated DonationCampaign[] @relation("DonationCampaignCreator")
  pledges                 Pledge[] @relation("PledgeDonor")
  sessions       Session[]
  authTokens     AuthToken[]
  cmsPages       CmsPage[]
  newsArticles   NewsArticle[]
  announcements  Announcement[]
  resources      Resource[]
  sermons        Sermon[]
  events         Event[]
  galleryAlbums  GalleryAlbum[]
  galleryMedia   GalleryMediaItem[]
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreator")
  attendanceRecordsRecorded AttendanceRecord[] @relation("AttendanceRecorder")
  attendanceCorrections     AttendanceCorrection[] @relation("AttendanceCorrectionActor")
  attendanceQrTokens        AttendanceQrToken[] @relation("AttendanceQrCreator")
  attendanceSeriesCreated   AttendanceSeries[] @relation("AttendanceSeriesCreator")
  notifications             AppNotification[]
  notificationPreference    NotificationPreference?
  communicationJobsCreated  CommunicationJob[] @relation("CommunicationJobCreator")
  notificationDeliveries    NotificationDelivery[] @relation("NotificationDeliveryActor")
  eventRegistrations        EventRegistration[] @relation("EventRegistrationUser")
  eventRegistrationsRecorded EventRegistration[] @relation("EventRegistrationRecorder")
  eventInvitations          EventInvitation[] @relation("EventInvitationRecipient")
  eventInvitationsCreated   EventInvitation[] @relation("EventInvitationCreator")
  sermonBookmarks           SermonBookmark[]
  mediaPlaylists            MediaPlaylist[] @relation("MediaPlaylistOwner")
  mediaJobsCreated          MediaProcessingJob[] @relation("MediaJobCreator")
  // Phase 19 pastoral care
  pastoralCasesCreated      PastoralCareCase[] @relation("PastoralCaseCreator")
  pastoralCasesAssigned     PastoralCareCase[] @relation("PastoralCaseAssignee")
  pastoralNotesAuthored     PastoralCareNote[] @relation("PastoralNoteAuthor")
  pastoralVisitsAssigned    PastoralVisit[] @relation("PastoralVisitAssignee")
  pastoralVisitsCreated     PastoralVisit[] @relation("PastoralVisitCreator")
  pastoralFollowUpsAssigned PastoralFollowUp[] @relation("PastoralFollowUpAssignee")
  pastoralFollowUpsCreated  PastoralFollowUp[] @relation("PastoralFollowUpCreator")
  pastoralAssignmentsMade   PastoralAssignmentHistory[] @relation("PastoralAssignmentActor")
  profileChangeRequests     MemberProfileChangeRequest[] @relation("ProfileChangeRequester")
  profileChangesReviewed    MemberProfileChangeRequest[] @relation("ProfileChangeReviewer")
  memberAdminNotesAuthored  MemberAdminNote[] @relation("MemberAdminNoteAuthor")
  memberDocumentsUploaded   MemberDocument[] @relation("MemberDocumentUploader")
  pastoralAccessLogs        PastoralAccessLog[] @relation("PastoralAccessActor")
  // Phase 20 finance administration
  expensesSubmitted         Expense[] @relation("ExpenseSubmitter")
  expensesReviewed          Expense[] @relation("ExpenseReviewer")
  expenseDocumentsUploaded  ExpenseDocument[] @relation("ExpenseDocumentUploader")
  budgetsCreated            Budget[] @relation("BudgetCreator")
  reconciliationsOwned      Reconciliation[] @relation("ReconciliationOwner")
  financialEntriesCreated   FinancialEntry[] @relation("FinancialEntryCreator")
  givingSchedules           GivingSchedule[] @relation("GivingScheduleOwner")
  givingQrLinksCreated      GivingQrLink[] @relation("GivingQrCreator")
  announcementReads         AnnouncementRead[]
  savedItems                SavedItem[]
  memberDevices             MemberDevice[]
  // Phase 21 staff & volunteers
  staffProfiles             StaffProfile[] @relation("StaffUser")
  staffSupervised           StaffProfile[] @relation("StaffSupervisor")
  staffStatusChanges        StaffStatusHistory[] @relation("StaffStatusActor")
  volunteerAppsReviewed     VolunteerApplication[] @relation("VolunteerAppReviewer")
  ministryTeamsLed          MinistryTeam[] @relation("MinistryTeamLeader")
  ministryTeamsAssisted     MinistryTeam[] @relation("MinistryTeamAssistant")
  roleAssignmentsMade       MinistryRoleAssignment[] @relation("RoleAssignmentActor")
  serviceAssignmentsCreated ServiceAssignment[] @relation("ServiceAssignmentCreator")
  trainingInstructed        TrainingSession[] @relation("TrainingInstructor")
  volunteerTasksAssigned    VolunteerTask[] @relation("VolunteerTaskAssignee")
  volunteerTasksCreated     VolunteerTask[] @relation("VolunteerTaskCreator")
  volunteerSubstitutionsCreated VolunteerSubstitution[] @relation("VolunteerSubstitutionActor")
  volunteerHourCorrections  VolunteerHourCorrection[] @relation("VolunteerHourActor")
  volunteerRequestsReviewed VolunteerRequest[] @relation("VolunteerRequestReviewer")
  // Phase 34 governance
  governanceAppointmentsMade GovernanceAppointment[] @relation("GovernanceAppointedBy")
  committeesChaired         Committee[] @relation("CommitteeChair")
  committeesSecretaried     Committee[] @relation("CommitteeSecretary")
  meetingsChaired           GovernanceMeeting[] @relation("MeetingChair")
  meetingsSecretaried       GovernanceMeeting[] @relation("MeetingSecretary")
  agendaItemsPresented      AgendaItem[] @relation("AgendaPresenter")
  minutesAuthored           MeetingMinute[] @relation("MinuteAuthor")
  decisionsCreated          GovernanceDecision[] @relation("DecisionCreator")
  resolutionsCreated        Resolution[] @relation("ResolutionCreator")
  votesCast                 GovernanceVote[] @relation("VoteCaster")
  actionItemsAssigned       GovernanceActionItem[] @relation("ActionItemAssignee")
  policiesAuthored          GovernancePolicy[] @relation("PolicyAuthor")
  policyVersionsAuthored    PolicyVersion[] @relation("PolicyVersionAuthor")
  governanceDocsUploaded    GovernanceDocument[] @relation("GovernanceDocUploader")
  adminRequestsAssigned     AdministrativeRequest[] @relation("AdminRequestAssignee")
  adminRequestNotes         AdminRequestNote[] @relation("AdminRequestNoteAuthor")
  approvalActionsTaken      ApprovalAction[] @relation("ApprovalActor")
  approvalDelegationsGiven  ApprovalDelegation[] @relation("DelegationFrom")
  approvalDelegationsReceived ApprovalDelegation[] @relation("DelegationTo")
  // Phase 22 scheduling
  eventChangesMade          EventChangeHistory[] @relation("EventChangeActor")
  resourceReservationsMade  ResourceReservation[] @relation("ResourceReservationActor")
  // Phase 23 membership
  membershipTypesCreated    MembershipType[] @relation("MembershipTypeCreator")
  baptismRecordsRecorded    BaptismRecord[] @relation("BaptismRecorder")
  confirmationRecordsRecorded ConfirmationRecord[] @relation("ConfirmationRecorder")
  transfersReviewed         MembershipTransfer[] @relation("TransferReviewer")
  memberCardsIssued         MemberCard[] @relation("MemberCardIssuer")
  memberMergesPerformed     MemberMergeRecord[] @relation("MemberMergeActor")
  memberImportsCreated      MemberImportJob[] @relation("MemberImportActor")
  // Phase 24 communications
  communicationTemplatesCreated CommunicationTemplate[] @relation("CommunicationTemplateCreator")
  conversationParticipations ConversationParticipant[]
  messagesSent              Message[] @relation("MessageSender")
  messageReportsFiled       MessageReport[] @relation("MessageReporter")
  messageReportsReviewed    MessageReport[] @relation("MessageReportReviewer")
  // Phase 25 CMS
  contentRevisionsCreated   ContentRevision[] @relation("ContentRevisionAuthor")
  contentTranslationsMade   ContentTranslation[] @relation("ContentTranslator")
  cmsFaqsAuthored           CmsFaq[] @relation("CmsFaqAuthor")
  cmsTestimonialsAuthored   CmsTestimonial[] @relation("CmsTestimonialAuthor")
  cmsMenusUpdated           CmsMenu[] @relation("CmsMenuUpdater")
  // Phase 26 digital library
  mediaPlaybackProgress     MediaPlaybackProgress[]
  mediaReportsFiled         MediaContentReport[] @relation("MediaReportReporter")
  mediaReportsReviewed      MediaContentReport[] @relation("MediaReportReviewer")
  mediaSubtitlesUploaded    MediaSubtitle[] @relation("MediaSubtitleUploader")
  // Phase 27 live streaming
  liveSessionsCreated       LiveSession[] @relation("LiveSessionCreator")
  liveChatMessages          LiveChatMessage[]
  liveChatModerations       LiveChatModeration[] @relation("LiveChatModerator")
  livePrayerRequests        LivePrayerRequest[] @relation("LivePrayerSubmitter")
  liveAttendances           LiveAttendance[]
  liveReactions             LiveReaction[]
  livePollResponses         LivePollResponse[]
  liveAnnouncementsCreated  LiveAnnouncement[] @relation("LiveAnnouncementAuthor")

  @@index([roleId])
  @@index([status])
  @@index([email])
}

model Role {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  hierarchy    Int      @default(0)
  isSystem     Boolean  @default(true)
  isPrivileged Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid())
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  rememberMe Boolean  @default(false)
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ============================================================
// Foundation: Church Settings (managed via admin)
// ============================================================

model ChurchSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "church_name", "service_times"
  value     String   // JSON-encoded value for complex settings
  updatedAt DateTime @updatedAt
}

// ============================================================
// Phase 13: Church Membership & Member Management
// ============================================================

enum MembershipStatus {
  approved
  active
  inactive
  visitor
  transferred
  suspended
  deceased
  archived
}

enum ApplicationStatus {
  submitted
  under_review
  needs_information
  resubmitted
  approved
  rejected
  archived
}

enum DirectoryVisibility {
  private
  members_only
  staff_only
  public
}

enum MemberMinistryStatus {
  interested
  active
  inactive
}

enum MinistryJoinRequestStatus {
  pending
  approved
  declined
}

model Household {
  id              String   @id @default(cuid())
  familyReference String?  @unique
  name            String
  primaryMemberId String?
  primaryMember   Member?  @relation("HouseholdPrimary", fields: [primaryMemberId], references: [id], onDelete: SetNull)
  addressNote     String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members     Member[] @relation("HouseholdMembers")
  memberships HouseholdMembership[]

  @@index([primaryMemberId])
  @@index([status])
  @@index([familyReference])
}

model HouseholdMembership {
  id               String    @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  relationship     String    @default("other") // parent | child | spouse | guardian | sibling | other
  isPrimaryContact Boolean   @default(false)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([householdId, memberId])
  @@index([memberId])
  @@index([householdId])
}

model Member {
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipNumber     String?             @unique
  displayName          String?
  preferredName        String?
  preferredLanguage    String              @default("en")
  status               MembershipStatus    @default(approved)
  membershipTypeId     String?
  membershipType       MembershipType?     @relation(fields: [membershipTypeId], references: [id], onDelete: SetNull)
  dateJoined           DateTime?
  dateOfBirth          DateTime?
  gender               String?
  addressNote          String?
  emergencyContactName String?
  emergencyContactPhone String?
  baptismDate          DateTime?
  baptismNote          String?
  joiningMethod        String?
  previousChurch       String?
  householdId          String?
  household            Household?          @relation("HouseholdMembers", fields: [householdId], references: [id], onDelete: SetNull)
  directoryVisibility  DirectoryVisibility @default(private)
  showProfilePhoto     Boolean             @default(false)
  showDisplayName      Boolean             @default(true)
  showMinistry         Boolean             @default(false)
  showContactButton    Boolean             @default(false)
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  attendance           AttendanceRecord[]
  applications         MembershipApplication[]
  ministries           MemberMinistry[]
  joinRequests         MinistryJoinRequest[]
  statusHistory        MembershipStatusHistory[]
  contributions        Contribution[]
  pledges              Pledge[]
  primaryFor           Household[]               @relation("HouseholdPrimary")
  householdMemberships HouseholdMembership[]
  pastoralCases        PastoralCareCase[]
  pastoralVisits       PastoralVisit[]
  profileChangeRequests MemberProfileChangeRequest[]
  adminNotes           MemberAdminNote[]
  documents            MemberDocument[]
  staffProfile         StaffProfile?
  volunteerProfile     VolunteerProfile?
  volunteerApplications VolunteerApplication[]
  teamMemberships      MinistryTeamMember[]
  roleAssignments      MinistryRoleAssignment[]
  serviceAssignments   ServiceAssignment[]
  volunteerAvailabilities VolunteerAvailability[]
  availabilityExceptions AvailabilityException[]
  trainingEnrollments  TrainingEnrollment[]
  volunteerTasks       VolunteerTask[]
  volunteerSkills      VolunteerSkill[]
  volunteerQualifications VolunteerQualification[]
  volunteerRequests    VolunteerRequest[]
  volunteerOnboarding  VolunteerOnboardingProgress[]
  substitutionsOriginal VolunteerSubstitution[] @relation("SubOriginal")
  substitutionsAsSub   VolunteerSubstitution[] @relation("SubSubstitute")
  governanceAppointments GovernanceAppointment[]
  committeeMemberships CommitteeMember[]
  meetingParticipations MeetingParticipant[]
  actionItemsOwned     GovernanceActionItem[] @relation("ActionItemOwner")
  policyAcknowledgements PolicyAcknowledgement[]
  administrativeRequests AdministrativeRequest[]
  baptismRecords       BaptismRecord[]
  confirmationRecords  ConfirmationRecord[]
  transfers            MembershipTransfer[]
  memberCards          MemberCard[]
  mergesAsSource       MemberMergeRecord[] @relation("MergeSource")
  mergesAsTarget       MemberMergeRecord[] @relation("MergeTarget")

  @@index([status])
  @@index([householdId])
  @@index([membershipNumber])
  @@index([dateJoined])
  @@index([membershipTypeId])
}

model MembershipApplication {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation("MembershipApplicant", fields: [userId], references: [id], onDelete: Cascade)
  memberId           String?
  member             Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status             ApplicationStatus @default(submitted)
  fullName           String
  preferredContact   String?
  preferredLanguage  String            @default("en")
  howHeard           String?
  ministryInterests  String?
  applicantNote      String?
  reviewerMessage    String?
  reviewNotes        String?
  reviewedById       String?
  reviewedBy         User?             @relation("MembershipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  submittedAt        DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  history MembershipStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([memberId])
  @@index([reviewedById])
}

model MembershipStatusHistory {
  id            String   @id @default(cuid())
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  applicationId String?
  application   MembershipApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oldStatus     String?
  newStatus     String
  changedById   String?
  changedBy     User?    @relation("MembershipHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  reason        String?
  createdAt     DateTime @default(now())

  @@index([memberId])
  @@index([applicationId])
  @@index([createdAt])
}

model MemberMinistry {
  id        String               @id @default(cuid())
  memberId  String
  member    Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministryId String
  ministry  Ministry             @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  roleLabel String?
  status    MemberMinistryStatus @default(active)
  joinedAt  DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([memberId, ministryId])
  @@index([ministryId])
  @@index([status])
}

model MinistryJoinRequest {
  id         String                     @id @default(cuid())
  memberId   String
  member     Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministryId String
  ministry   Ministry                   @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  status     MinistryJoinRequestStatus  @default(pending)
  note       String?
  createdAt  DateTime                   @default(now())
  reviewedAt DateTime?

  @@index([memberId])
  @@index([ministryId])
  @@index([status])
}

// ============================================================
// Foundation: Ministry (Phase 4)
// ============================================================

model Ministry {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  leaderName   String?
  category     String?
  imageUrl     String?
  status       ContentStatus @default(draft)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  leaderUserId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events Event[]
  galleryAlbums GalleryAlbum[]
  galleryMedia GalleryMediaItem[]
  memberParticipations MemberMinistry[]
  joinRequests MinistryJoinRequest[]
  attendanceSessions AttendanceSession[]
  attendanceSeries AttendanceSeries[]
  contributions Contribution[]
  campaigns DonationCampaign[]
  donationFunds DonationCategory[]
  announcements Announcement[]
  communicationJobs CommunicationJob[]
  teams MinistryTeam[]
  roleAssignments MinistryRoleAssignment[]
  serviceAssignments ServiceAssignment[]
  volunteerApplications VolunteerApplication[]
  trainingPrograms TrainingProgram[]
  departments MinistryDepartment[]
  volunteerRoles VolunteerRole[]
  volunteerRequirements VolunteerMinistryRequirement[]
  onboardingTemplates VolunteerOnboardingTemplate[]
  committees Committee[]
  governanceMeetings GovernanceMeeting[]

  @@index([status])
  @@index([isActive])
  @@index([category])
  @@index([leaderUserId])
  @@index([sortOrder])
}

model LeadershipPosition {
  id          String   @id @default(uuid())
  title       String
  description String?
  responsibilities String?
  termMonths  Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaders      Leader[]
  appointments GovernanceAppointment[]

  @@index([isActive])
  @@index([sortOrder])
}

model Leader {
  id         String        @id @default(uuid())
  firstName  String
  lastName   String
  slug       String?       @unique
  title      String?
  bio        String?
  photoUrl   String?
  email      String?
  phone      String?
  status     ContentStatus @default(draft)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  positionId String?
  position   LeadershipPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  sermons    Sermon[]
  events     Event[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([isActive])
  @@index([positionId])
  @@index([sortOrder])
}

// ============================================================
// Phase 9: Sermon Management & Library (+ Phase 18 extensions)
// ============================================================

enum SermonContentType {
  sermon
  bible_study
  devotion
  teaching
  testimony
  conference
  special
}

enum MediaAccessLevel {
  public
  members
  restricted
}

enum MediaJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

model SermonCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sermons Sermon[]

  @@index([sortOrder])
}

model SermonSeries {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?
  imageUrl         String?
  imageAlt         String?
  status           CmsStatus @default(draft)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  publishAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sermons Sermon[]
  playlistItems MediaPlaylistItem[]

  @@index([status])
  @@index([slug])
}

model Sermon {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  description    String?
  notes          String?
  transcript     String?
  transcriptStatus String  @default("draft") // draft | review | published
  contentType    SermonContentType @default(sermon)
  accessLevel    MediaAccessLevel  @default(public)
  speakerName    String?
  speakerId      String?
  speaker        Leader?   @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  seriesId       String?
  series         SermonSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       SermonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sermonDate     DateTime
  durationSeconds Int?
  thumbnailUrl   String?
  thumbnailAlt   String?
  audioUrl       String?
  audioFileName  String?
  audioMime      String?
  audioSize      Int?
  audioContentHash String?
  videoUrl       String?
  notesFileUrl   String?
  notesFileName  String?
  notesFileMime  String?
  notesFileSize  Int?
  allowDownload  Boolean   @default(true)
  allowPodcast   Boolean   @default(true)
  copyrightHolder String?
  license         String?
  sourceAttribution String?
  status         CmsStatus @default(draft)
  isFeatured     Boolean   @default(false)
  playCount      Int       @default(0)
  viewCount      Int       @default(0)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt    DateTime?
  publishAt      DateTime?
  audioDownloads Int       @default(0)
  notesDownloads Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  scriptures     SermonScripture[]
  galleryMedia   GalleryMediaItem[]
  bookmarks      SermonBookmark[]
  playlistItems  MediaPlaylistItem[]
  playbackProgress MediaPlaybackProgress[]
  subtitles      MediaSubtitle[]
  contentReports MediaContentReport[]
  liveSessions   LiveSession[] @relation("LiveSessionRecording")

