}

model GalleryMediaItem {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String?
  mediaType      GalleryMediaType
  fileUrl        String?
  thumbnailUrl   String?
  externalUrl    String?
  albumId        String
  album          GalleryAlbum     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ministryId     String?
  ministry       Ministry?        @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  sermonId       String?
  sermon         Sermon?          @relation(fields: [sermonId], references: [id], onDelete: SetNull)
  caption        String?
  altText        String?
  photographer   String?
  takenAt        DateTime?
  status         GalleryStatus    @default(draft)
  isFeatured     Boolean          @default(false)
  sortOrder      Int              @default(0)
  width          Int?
  height         Int?
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([albumId])
  @@index([status])
  @@index([mediaType])
  @@index([eventId])
  @@index([ministryId])
  @@index([sermonId])
  @@index([sortOrder])
  @@index([authorId])
}

// ============================================================
// Phase 15: Church Donations, Tithes & Offering Management
// ============================================================

enum ContributionStatus {
  pending
  processing
  successful
  failed
  cancelled
  refunded
  partially_refunded
}

enum ContributionPaymentMethod {
  online
  bank_transfer
  cash
  other
}

enum CampaignStatus {
  draft
  active
  paused
  completed
  archived
}

enum PledgeFrequency {
  one_time
  monthly
  quarterly
  yearly
}

enum PledgeStatus {
  draft
  active
  paused
  completed
  cancelled
}

enum PaymentTxnStatus {
  pending
  processing
  successful
  failed
  cancelled
  refunded
  partially_refunded
}

enum WebhookProcessingStatus {
  received
  processed
  ignored
  failed
}

model DonationCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  /// Public giving form visibility (inactive funds stay for historical records)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// Minimum amount in major currency units as Decimal
  minAmount   Decimal  @default(1.00)
  maxAmount   Decimal?
  /// Comma-separated ISO currency codes; never silently convert between them
  supportedCurrencies String @default("ETB")
  /// JSON array of preset amount strings, e.g. ["100","250","500","1000"]
  presetAmounts       String?
  accountingCode      String?
  ministryId          String?
  ministry            Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  eventId             String?
  event               Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contributions Contribution[]
  campaigns     DonationCampaign[]
  expenses      Expense[]
  budgets       Budget[]
  financialEntries FinancialEntry[]
  givingSchedules GivingSchedule[]

  @@index([isActive])
  @@index([isPublic])
  @@index([sortOrder])
  @@index([ministryId])
  @@index([eventId])
}

model DonationCampaign {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  targetAmount  Decimal
  currency      String         @default("ETB")
  startAt       DateTime?
  endAt         DateTime?
  status        CampaignStatus @default(draft)
  coverImageUrl String?
  categoryId    String?
  category      DonationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ministryId    String?
  ministry      Ministry?      @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("DonationCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contributions Contribution[]
  pledges       Pledge[]

  @@index([status])
  @@index([slug])
  @@index([ministryId])
  @@index([categoryId])
}

model Contribution {
  id               String                     @id @default(cuid())
  reference        String                     @unique
  receiptNumber    String?                    @unique
  amount           Decimal
  currency         String                     @default("ETB")
  refundedAmount   Decimal                    @default(0)
  status           ContributionStatus         @default(pending)
  paymentMethod    ContributionPaymentMethod  @default(online)
  isAnonymous      Boolean                    @default(false)
  note             String?
  offlineReference String?
  idempotencyKey   String?                    @unique
  userId           String?
  user             User?                      @relation("ContributionDonor", fields: [userId], references: [id], onDelete: SetNull)
  memberId         String?
  member           Member?                    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  guestName        String?
  guestEmail       String?
  categoryId       String
  category         DonationCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  campaignId       String?
  campaign         DonationCampaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ministryId       String?
  ministry         Ministry?                  @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  eventId          String?
  event            Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recordedById     String?
  recordedBy       User?                      @relation("ContributionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  completedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  transactions PaymentTransaction[]
  refunds      ContributionRefund[]
  pledges      Pledge[]
  financialEntries FinancialEntry[]
  givingScheduleItems GivingSchedule[]

  @@index([status])
  @@index([userId])
  @@index([memberId])
  @@index([categoryId])
  @@index([campaignId])
  @@index([eventId])
  @@index([createdAt])
  @@index([completedAt])
  @@index([paymentMethod])
  @@index([expiresAt])
}

model PaymentTransaction {
  id                String           @id @default(cuid())
  contributionId    String
  contribution      Contribution     @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  provider          String
  providerReference String?
  idempotencyKey    String           @unique
  amount            Decimal
  currency          String           @default("ETB")
  status            PaymentTxnStatus @default(pending)
  failureReason     String?
  initiatedAt       DateTime         @default(now())
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, providerReference])
  @@index([contributionId])
  @@index([status])
  @@index([provider])
}

model ContributionRefund {
  id             String       @id @default(cuid())
  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  amount         Decimal
  currency       String       @default("ETB")
  reason         String
  recordedById   String?
  recordedBy     User?        @relation("ContributionRefundActor", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([contributionId])
  @@index([createdAt])
}

model Pledge {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation("PledgeDonor", fields: [userId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       DonationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount         Decimal
  currency       String          @default("ETB")
  frequency      PledgeFrequency @default(one_time)
  status         PledgeStatus    @default(draft)
  startAt        DateTime?
  endAt          DateTime?
  note           String?
  /// Recurring charges require provider tokenization; never store card data here.
  providerSubscriptionId String?
  fulfilledContributionId String?
  fulfilledContribution   Contribution? @relation(fields: [fulfilledContributionId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([status])
}

model PaymentWebhookEvent {
  id               String                  @id @default(cuid())
  provider         String
  eventKey         String
  processingStatus WebhookProcessingStatus @default(received)
  signatureValid   Boolean                 @default(false)
  contributionId   String?
  transactionId    String?
  summary          String?
  createdAt        DateTime                @default(now())
  processedAt      DateTime?

  @@unique([provider, eventKey])
  @@index([processingStatus])
  @@index([createdAt])
}

model ReceiptSequence {
  id        String @id @default("default")
  prefix    String @default("BME-REC")
  nextValue Int    @default(1)
}

// ============================================================
// Phase 28: Online giving platform extensions (funds, providers, QR, settings)
// ============================================================

enum GivingQrTargetType {
  general
  fund
  campaign
  ministry
  event
}

enum PaymentProviderEnvironment {
  sandbox
  production
}

/// Non-secret provider configuration. Secrets stay in environment variables only.
model PaymentProviderConfig {
  id                  String                      @id @default(cuid())
  providerKey         String                      @unique
  displayName         String
  environment         PaymentProviderEnvironment  @default(sandbox)
  isEnabled           Boolean                     @default(false)
  /// Publishable / public key only — never a secret
  publicKey           String?
  /// Name of env var holding the secret (e.g. PAYMENT_API_KEY), not the secret value
  secretEnvKey        String?
  webhookPath         String?
  supportedCurrencies String                      @default("ETB")
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([isEnabled])
  @@index([providerKey])
}

model ChurchGivingSettings {
  id                   String   @id @default("default")
  /// Month (1-12) when the church giving/reporting year starts
  givingYearStartMonth Int      @default(1)
  supportedCurrencies  String   @default("ETB")
  defaultCurrency      String   @default("ETB")
  legalChurchName      String?
  registrationInfo     String?
  donationTerms        String?
  refundPolicyNote     String?
  privacyNote          String?
  updatedAt            DateTime @updatedAt
}

model GivingQrLink {
  id            String            @id @default(cuid())
  slug          String            @unique
  label         String
  targetType    GivingQrTargetType @default(general)
  categorySlug  String?
  campaignSlug  String?
  ministrySlug  String?
  eventSlug     String?
  amountPreset  String?
  currency      String?
  isActive      Boolean           @default(true)
  createdById   String?
  createdBy     User?             @relation("GivingQrCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive])
  @@index([targetType])
  @@index([createdAt])
}

// ============================================================
// Phase 20: Finance administration (expenses, budgets, ledger, reconciliation)
// ============================================================

enum ExpenseStatus {
  draft
  submitted
  under_review
  approved
  rejected
  paid
  cancelled
}

enum BudgetPeriod {
  monthly
  quarterly
  annual
}

enum BudgetStatus {
  draft
  active
  closed
  archived
}

enum ReconciliationStatus {
  open
  in_progress
  reconciled
  disputed
  closed
}

enum FinancialEntryType {
  income
  expense
  refund
  adjustment
}

enum FinancialEntryStatus {
  posted
  voided
}

enum GivingScheduleStatus {
  active
  paused
  cancelled
  completed
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]
  budgets  Budget[]

  @@index([isActive])
  @@index([sortOrder])
}

model Expense {
  id            String        @id @default(cuid())
  reference     String        @unique
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fundId        String?
  fund          DonationCategory? @relation(fields: [fundId], references: [id], onDelete: SetNull)
  amount        Decimal
  currency      String        @default("ETB")
  vendor        String?
  description   String
  expenseDate   DateTime
  status        ExpenseStatus @default(draft)
  submittedById String
  submittedBy   User          @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?         @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  paidAt        DateTime?
  rejectionReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  documents ExpenseDocument[]
  financialEntries FinancialEntry[]

  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([fundId])
  @@index([submittedById])
  @@index([createdAt])
}

model ExpenseDocument {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("ExpenseDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  title        String
  fileUrl      String
  fileName     String?
  fileMime     String?
  fileSize     Int?
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@index([createdAt])
}

model Budget {
  id               String       @id @default(cuid())
  name             String
  fundId           String?
  fund             DonationCategory? @relation(fields: [fundId], references: [id], onDelete: SetNull)
  expenseCategoryId String?
  expenseCategory  ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  period           BudgetPeriod @default(annual)
  periodStart      DateTime
  periodEnd        DateTime
  allocatedAmount  Decimal
  currency         String       @default("ETB")
  status           BudgetStatus @default(draft)
  createdById      String?
  createdBy        User?        @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([fundId])
  @@index([expenseCategoryId])
}

model Reconciliation {
  id                 String               @id @default(cuid())
  periodLabel        String
  source             String
  statementReference String?
  openingBalance     Decimal              @default(0)
  closingBalance     Decimal              @default(0)
  expectedTotal      Decimal              @default(0)
  actualTotal        Decimal              @default(0)
  status             ReconciliationStatus @default(open)
  notes              String?
  reconciledById     String?
  reconciledBy       User?                @relation("ReconciliationOwner", fields: [reconciledById], references: [id], onDelete: SetNull)
  reconciledAt       DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  matches ReconciliationMatch[]

  @@index([status])
  @@index([createdAt])
}

model ReconciliationMatch {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  contributionId   String?
  externalReference String?
  amount           Decimal
  matchedAt        DateTime       @default(now())
  note             String?

  @@index([reconciliationId])
  @@index([contributionId])
}

model FinancialEntry {
  id             String               @id @default(cuid())
  type           FinancialEntryType
  status         FinancialEntryStatus @default(posted)
  reference      String               @unique
  amount         Decimal
  currency       String               @default("ETB")
  entryDate      DateTime
  fundId         String?
  fund           DonationCategory?    @relation(fields: [fundId], references: [id], onDelete: SetNull)
  contributionId String?
  contribution   Contribution?        @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  expenseId      String?
  expense        Expense?             @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  description    String?
  createdById    String?
  createdBy      User?                @relation("FinancialEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([type])
  @@index([status])
  @@index([entryDate])
  @@index([fundId])
  @@index([contributionId])
  @@index([expenseId])
  @@index([createdAt])
}

model GivingSchedule {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("GivingScheduleOwner", fields: [userId], references: [id], onDelete: Cascade)
  fundId              String
  fund                DonationCategory     @relation(fields: [fundId], references: [id], onDelete: Restrict)
  amount              Decimal
  currency            String               @default("ETB")
  frequency           PledgeFrequency      @default(monthly)
  status              GivingScheduleStatus @default(active)
  provider            String?
  providerReference   String?
  nextPaymentAt       DateTime?
  lastContributionId  String?
  lastContribution    Contribution?        @relation(fields: [lastContributionId], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([fundId])
  @@index([status])
  @@index([nextPaymentAt])
}

// ============================================================
// Phase 14: Church Attendance & Check-in
// ============================================================

enum AttendanceSessionStatus {
  draft
  scheduled
  open
  closed
  archived
}

enum AttendanceSessionType {
  sunday_service
  worship
  bible_study
  prayer_meeting
  youth
  children
  conference
  ministry
  special_event
  other
}

enum AttendanceRecordStatus {
  present
  absent
  excused
  late
  cancelled
}

enum AttendanceCheckInMethod {
  manual
  self
  admin
  qr
  imported
}

enum AttendanceRecurrence {
  none
  weekly
  biweekly
  monthly
}

model AttendanceSeries {
  id                 String               @id @default(cuid())
  title              String
  sessionType        AttendanceSessionType @default(sunday_service)
  ministryId         String?
  ministry           Ministry?            @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  locationId         String?
  location           EventLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationNote       String?
  recurrence         AttendanceRecurrence @default(weekly)
  dayOfWeek          Int?
  startTimeLocal     String
  endTimeLocal       String?
  timezone           String               @default("Africa/Addis_Ababa")
  isActive           Boolean              @default(true)
  createdById        String?
  createdBy          User?                @relation("AttendanceSeriesCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sessions AttendanceSession[]

  @@index([ministryId])
  @@index([isActive])
  @@index([sessionType])
}

model AttendanceSession {
  id            String                  @id @default(cuid())
  title         String
  sessionType   AttendanceSessionType   @default(sunday_service)
  status        AttendanceSessionStatus @default(draft)
  startsAt      DateTime
  endsAt        DateTime?
  timezone      String                  @default("Africa/Addis_Ababa")
  locationNote  String?
  notes         String?
  eventId       String?
  event         Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ministryId    String?
  ministry      Ministry?               @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  locationId    String?
  location      EventLocation?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  seriesId      String?
  series        AttendanceSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  allowSelfCheckIn Boolean              @default(true)
  allowQrCheckIn   Boolean              @default(true)
  openedAt      DateTime?
  closedAt      DateTime?
  createdById   String?
  createdBy     User?                   @relation("AttendanceSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  records AttendanceRecord[]
  qrTokens AttendanceQrToken[]

  @@index([status])
  @@index([startsAt])
  @@index([sessionType])
  @@index([eventId])
  @@index([ministryId])
  @@index([seriesId])
  @@index([createdById])
}

model AttendanceRecord {
  id           String                  @id @default(cuid())
  sessionId    String
  session      AttendanceSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status       AttendanceRecordStatus  @default(present)
  method       AttendanceCheckInMethod @default(manual)
  checkInAt    DateTime?
  checkOutAt   DateTime?
  recordedById String?
  recordedBy   User?                   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  corrections AttendanceCorrection[]

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@index([status])
  @@index([checkInAt])
  @@index([recordedById])
}

model AttendanceCorrection {
  id           String           @id @default(cuid())
  recordId     String
  record       AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  oldValue     String
  newValue     String
  reason       String
  changedById  String?
  changedBy    User?            @relation("AttendanceCorrectionActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([recordId])
  @@index([changedById])
  @@index([createdAt])
}

model AttendanceQrToken {
  id          String            @id @default(cuid())
  sessionId   String
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String            @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdById String?
  createdBy   User?             @relation("AttendanceQrCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([sessionId])
  @@index([expiresAt])
}

// ============================================================
// Foundation: Audit Log (security/compliance)
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "create", "update", "delete", "login", "logout"
  entity     String   // "member", "sermon", "event", etc.
  entityId   String?
  details    String?  // JSON-encoded change details
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ============================================================
// Foundation: Resource (Phase 9)
// ============================================================

model Resource {
  id             String               @id @default(cuid())
  title          String
  slug           String               @unique
  description    String?
  content        String?
  fileUrl        String?
  fileName       String?
  fileMime       String?
  fileSize       Int?
  thumbnailUrl   String?
  thumbnailAlt   String?
  externalUrl    String?
  accessLevel    MediaAccessLevel     @default(public)
  copyrightHolder String?
  license         String?
  version         Int                 @default(1)
  status         CmsStatus            @default(draft)
  isFeatured     Boolean              @default(false)
  downloadCount  Int                  @default(0)
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       ContentCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt    DateTime?
  publishAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured])
  @@index([accessLevel])
}

// ============================================================
// Phase 4: Church Information & Content Management
// ============================================================

model ChurchProfile {
  id             String   @id @default(cuid())
  name           String
  shortName      String?
  nameNative     String?
  description    String?
  welcomeMessage String?
  history        String?
  vision         String?
  mission        String?
  beliefs        String?
  coreValues     String?
  worshipInfo    String?
  logoUrl        String?
  faviconUrl     String?
  ogImageUrl     String?
  email          String?
  phone          String?
  website        String?
  denomination   String?
  language       String?
  status         ContentStatus @default(draft)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceSchedules ServiceSchedule[]
  locations        ChurchLocation[]
  socialLinks      SocialLink[]
}

model ServiceSchedule {
  id          String   @id @default(cuid())
  dayOfWeek   String   // "Sunday", "Monday", etc.
  serviceName String
  startTime   String   // HH:MM format
  endTime     String?
  description String?
  location    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  churchProfileId String
  churchProfile    ChurchProfile @relation(fields: [churchProfileId], references: [id], onDelete: Cascade)

  @@index([churchProfileId])
  @@index([dayOfWeek])
  @@index([sortOrder])
}

model ChurchLocation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  address        String?
  city           String?
  region         String?
  country        String?
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  isMainLocation Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  churchProfileId String
  churchProfile    ChurchProfile @relation(fields: [churchProfileId], references: [id], onDelete: Cascade)

  @@index([churchProfileId])
  @@index([isMainLocation])
}

model SocialLink {
  id         String   @id @default(cuid())
  platform   String   // "facebook", "youtube", "telegram", etc.
  url        String
  displayName String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  churchProfileId String
  churchProfile    ChurchProfile @relation(fields: [churchProfileId], references: [id], onDelete: Cascade)

  @@index([churchProfileId])
  @@index([platform])
  @@index([sortOrder])
}

// ============================================================
// Phase 8: Content Management System
// ============================================================

model ContentCategory {
  id          String               @id @default(cuid())
  name        String
  slug        String
  description String?
  scope       ContentCategoryScope
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  newsArticles NewsArticle[]
  resources    Resource[]

  @@unique([scope, slug])
  @@index([scope])
}

model ContentTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news NewsArticleTag[]
}

model CmsPage {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  excerpt          String?
  content          String
  featuredImageUrl String?
  featuredImageAlt String?
  status           CmsStatus @default(draft)
  visibility       String    @default("public") // public | members | private
  language         String    @default("en")
  isFeatured       Boolean   @default(false)
  sortOrder        Int       @default(0)
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt      DateTime?
  publishAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([slug])
  @@index([authorId])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([visibility])
  @@index([language])
  @@index([expiresAt])
}

model NewsArticle {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  excerpt          String?
  content          String
  featuredImageUrl String?
  featuredImageAlt String?
  status           CmsStatus @default(draft)
  isFeatured       Boolean   @default(false)
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  categoryId       String?
  category         ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt      DateTime?
  publishAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tags             NewsArticleTag[]

  @@index([status])
  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([publishedAt])
}

model NewsArticleTag {
  newsId String
  tagId  String
  news   NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    ContentTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}


// ============================================================
// Phase 19: Pastoral Care & Membership Extensions
// ============================================================

enum PastoralCaseStatus {
  open
  in_progress
  on_hold
  resolved
  closed
}

enum PastoralPriority {
  low
  normal
  high
}

enum PastoralNoteVisibility {
  case_team
  pastoral_staff
  role_restricted
}

enum PastoralVisitStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum PastoralVisitLocation {
  church
  member_home
  hospital
  other
  online
}

enum PastoralFollowUpStatus {
  pending
  in_progress
  completed
  cancelled
}

enum ProfileChangeRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model PastoralCareCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases PastoralCareCase[]

  @@index([isActive])
  @@index([sortOrder])
}

model PastoralCareCase {
  id           String             @id @default(cuid())
  memberId     String
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     PastoralCareCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title        String
  summary      String?
  priority     PastoralPriority   @default(normal)
  status       PastoralCaseStatus @default(open)
  assignedToId String?
  assignedTo   User?              @relation("PastoralCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User               @relation("PastoralCaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  openedAt     DateTime           @default(now())
  closedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  notes       PastoralCareNote[]
  visits      PastoralVisit[]
  followUps   PastoralFollowUp[]
  assignments PastoralAssignmentHistory[]

  @@index([memberId])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([openedAt])
  @@index([createdAt])
}

model PastoralAssignmentHistory {
  id               String   @id @default(cuid())
  caseId           String
  case             PastoralCareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  previousAssigneeId String?
  newAssigneeId    String?
  changedById      String?
  changedBy        User?    @relation("PastoralAssignmentActor", fields: [changedById], references: [id], onDelete: SetNull)
  reason           String?
  createdAt        DateTime @default(now())

  @@index([caseId])
  @@index([createdAt])
}

model PastoralCareNote {
  id         String                 @id @default(cuid())
  caseId     String
  case       PastoralCareCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                   @relation("PastoralNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content    String
  visibility PastoralNoteVisibility @default(case_team)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([caseId])
  @@index([authorId])
  @@index([createdAt])
}

model PastoralVisit {
  id             String                @id @default(cuid())
  memberId       String
  member         Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  caseId         String?
  case           PastoralCareCase?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?                 @relation("PastoralVisitAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User                  @relation("PastoralVisitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scheduledAt    DateTime
  completedAt    DateTime?
  status         PastoralVisitStatus   @default(scheduled)
  locationType   PastoralVisitLocation @default(church)
  locationNote   String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([memberId])
  @@index([caseId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@index([status])
}

model PastoralFollowUp {
  id           String                 @id @default(cuid())
  caseId       String?
  case         PastoralCareCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  memberId     String?
  assignedToId String?
  assignedTo   User?                  @relation("PastoralFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User                   @relation("PastoralFollowUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  task         String
  dueDate      DateTime?
  status       PastoralFollowUpStatus @default(pending)
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([caseId])
  @@index([memberId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

model MemberProfileChangeRequest {
  id           String                     @id @default(cuid())
  memberId     String
  member       Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy  User                       @relation("ProfileChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?                      @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  status       ProfileChangeRequestStatus @default(pending)
  payload      String
  staffNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

model MemberAdminNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("MemberAdminNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([createdAt])
}

model MemberDocument {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("MemberDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  title        String
  fileUrl      String
  fileName     String?
  fileMime     String?
  fileSize     Int?
  retentionUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId])
  @@index([createdAt])
}

model PastoralAccessLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("PastoralAccessActor", fields: [actorId], references: [id], onDelete: SetNull)
  resource   String
  resourceId String?
  action     String
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

// ============================================================
// Phase 21: Staff, Volunteers & Ministry Management
// ============================================================

enum StaffStatus {
  active
  on_leave
  suspended
  inactive
  former
}

enum VolunteerStatus {
  interested
  applicant
  pending_review
  approved
  active
  temporarily_unavailable
  inactive
  suspended
  archived
  former
}

enum VolunteerApplicationStatus {
  draft
  submitted
  under_review
  more_info
  approved
  rejected
  withdrawn
}

enum SkillProficiency {
  beginner
  intermediate
  advanced
  expert
}

enum ServiceAssignmentStatus {
  proposed
  assigned
  confirmed
  declined
  completed
  absent
  replaced
  cancelled
}

enum TrainingEnrollmentStatus {
  enrolled
  attended
  completed
  did_not_complete
  cancelled
}

enum VolunteerTaskStatus {
  todo
  in_progress
  completed
  cancelled
}

model StaffDepartment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff StaffProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

model StaffPosition {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff StaffProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

model StaffProfile {
  id            String      @id @default(cuid())
  staffNumber   String?     @unique
  userId        String
  user          User        @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  memberId      String?     @unique
  member        Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    StaffDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId    String?
  position      StaffPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  supervisorId  String?
  supervisor    User?       @relation("StaffSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  status        StaffStatus @default(active)
  startDate     DateTime?
  workEmail     String?
  workPhone     String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  statusHistory StaffStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([departmentId])
  @@index([positionId])
  @@index([supervisorId])
}

model StaffStatusHistory {
  id          String   @id @default(cuid())
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  oldStatus   String?
  newStatus   String
  reason      String?
  changedById String?
  changedBy   User?    @relation("StaffStatusActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@index([createdAt])
}

model VolunteerSkillCatalog {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills VolunteerSkill[]
  roles VolunteerRole[]
  requirements VolunteerMinistryRequirement[]

  @@index([isActive])
}

model VolunteerProfile {
  id        String          @id @default(cuid())
  memberId  String          @unique
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    VolunteerStatus @default(applicant)
  joinedAt  DateTime?
  experience String?
  maxFrequencyPerMonth Int?
  preferredServiceTypes String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
}

model VolunteerApplication {
  id               String                     @id @default(cuid())
  memberId         String
  member           Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministryId       String?
  ministry         Ministry?                  @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  status           VolunteerApplicationStatus @default(draft)
  preferredMinistry String?
  skills           String?
  experience       String?
  availability     String?
  motivation       String?
  preferredTimes   String?
  reviewerMessage  String?
  reviewNotes      String?
  reviewedById     String?
  reviewedBy       User?                      @relation("VolunteerAppReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([memberId])
  @@index([ministryId])
  @@index([status])
  @@index([submittedAt])
}

model VolunteerSkill {
  id           String           @id @default(cuid())
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skillId      String
  skill        VolunteerSkillCatalog @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency  SkillProficiency @default(beginner)
  createdAt    DateTime         @default(now())

  @@unique([memberId, skillId])
  @@index([skillId])
}

model VolunteerQualification {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title       String
  issuer      String?
  earnedAt    DateTime?
  expiresAt   DateTime?
  programId   String?
  program     TrainingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  fileUrl     String?
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
  @@index([programId])
}

model MinistryTeam {
  id          String   @id @default(cuid())
  ministryId  String
  ministry    Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  departmentId String?
  department  MinistryDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name        String
  slug        String
  description String?
  leaderUserId String?
  leaderUser  User?    @relation("MinistryTeamLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  assistantLeaderUserId String?
  assistantLeaderUser User? @relation("MinistryTeamAssistant", fields: [assistantLeaderUserId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members MinistryTeamMember[]
  roleAssignments MinistryRoleAssignment[]
  serviceAssignments ServiceAssignment[]
  tasks VolunteerTask[]
  volunteerRoles VolunteerRole[]
  requirements VolunteerMinistryRequirement[]

  @@unique([ministryId, slug])
  @@index([ministryId])
  @@index([departmentId])
  @@index([leaderUserId])
  @@index([assistantLeaderUserId])
  @@index([isActive])
}

model MinistryTeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      MinistryTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleLabel String?
  status    String   @default("active")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, memberId])
  @@index([memberId])
  @@index([status])
}

model MinistryRoleAssignment {
  id           String   @id @default(cuid())
  ministryId   String
  ministry     Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  teamId       String?
  team         MinistryTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleName     String
  startDate    DateTime @default(now())
  endDate      DateTime?
  status       String   @default("active")
  assignedById String?
  assignedBy   User?    @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ministryId])
  @@index([teamId])
  @@index([memberId])
  @@index([status])
  @@index([startDate])
}

model VolunteerAvailability {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isAvailable Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([dayOfWeek])
}

model AvailabilityException {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  isAvailable Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([startAt])
  @@index([endAt])
}

model ServiceAssignment {
  id           String                  @id @default(cuid())
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ministryId   String?
  ministry     Ministry?               @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  teamId       String?
  team         MinistryTeam?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roleId       String?
  volunteerRole VolunteerRole?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleName     String
  scheduledAt  DateTime
  endsAt       DateTime?
  status       ServiceAssignmentStatus @default(proposed)
  declineReason String?
  attendanceStatus String?
  checkInAt    DateTime?
  checkOutAt   DateTime?
  hoursMinutes Int?
  checkInTokenHash String?             @unique
  createdById  String?
  createdBy    User?                   @relation("ServiceAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  substitutions VolunteerSubstitution[]
  hourCorrections VolunteerHourCorrection[]

  @@index([eventId])
  @@index([memberId])
  @@index([ministryId])
  @@index([teamId])
  @@index([roleId])
  @@index([scheduledAt])
  @@index([status])
  @@index([attendanceStatus])
}

model TrainingProgram {
  id          String   @id @default(cuid())
  ministryId  String?
  ministry    Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  expiresAfterDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions TrainingSession[]
  roles VolunteerRole[]
  requirements VolunteerMinistryRequirement[]
  qualifications VolunteerQualification[]
  onboardingItems VolunteerOnboardingItem[]

  @@index([ministryId])
  @@index([isActive])
}

model TrainingSession {
  id            String   @id @default(cuid())
  programId     String
  program       TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  capacity      Int?
  instructorId  String?
  instructor    User?    @relation("TrainingInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  status        String   @default("scheduled")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments TrainingEnrollment[]
  waitlist    TrainingWaitlist[]

  @@index([programId])
  @@index([startsAt])
  @@index([status])
}

model TrainingEnrollment {
  id        String                   @id @default(cuid())
  sessionId String
  session   TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    TrainingEnrollmentStatus @default(enrolled)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@index([status])
}

model TrainingWaitlist {
  id        String   @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([sessionId, memberId])
  @@index([sessionId])
  @@index([position])
