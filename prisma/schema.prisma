  seoDescription        String?
  ogImageUrl            String?
  authorId              String
  author                User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt           DateTime?
  publishAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

