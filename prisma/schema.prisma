  providerVideoId      String?
  thumbnailUrl         String?
  visibility           LiveVisibility     @default(public)
  chatEnabled          Boolean            @default(true)
  prayerEnabled        Boolean            @default(true)
  attendanceEnabled    Boolean            @default(true)
  reactionsEnabled     Boolean            @default(true)
  pollsEnabled         Boolean            @default(false)
  scheduledStartAt     DateTime
  scheduledEndAt       DateTime?
  actualStartedAt      DateTime?
  actualEndedAt        DateTime?
  timezone             String             @default("Africa/Addis_Ababa")
  peakViewers          Int                @default(0)
  approximateViewers   Int                @default(0)
  recordingSermonId    String?
  recordingSermon      Sermon?            @relation("LiveSessionRecording", fields: [recordingSermonId], references: [id], onDelete: SetNull)
  currentProgramItemId String?
  seoTitle             String?
  seoDescription       String?
  createdById          String?
  createdBy            User?              @relation("LiveSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  chatMessages   LiveChatMessage[]
  chatMods       LiveChatModeration[]
  prayerRequests LivePrayerRequest[]
  attendances    LiveAttendance[]
  reactions      LiveReaction[]
  polls          LivePoll[]
  announcements  LiveAnnouncement[]
  programCursors LiveProgramCursor[]

  @@index([eventId])
  @@index([status])
  @@index([scheduledStartAt])
  @@index([visibility])
  @@index([provider])
  @@index([createdAt])
}

model LiveProgramCursor {
  id             String      @id @default(cuid())
  liveSessionId  String
  liveSession    LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  programItemId  String
  label          String?
  startedAt      DateTime    @default(now())
  completedAt    DateTime?

  @@index([liveSessionId])
  @@index([programItemId])
}

model LiveChatMessage {
  id            String                @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession           @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName   String
  body          String
  status        LiveChatMessageStatus @default(visible)
  createdAt     DateTime              @default(now())

  moderations LiveChatModeration[]

  @@index([liveSessionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model LiveChatModeration {
  id            String          @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession     @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  messageId     String?
  message       LiveChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  action        String
  reason        String?
  moderatorId   String
  moderator     User            @relation("LiveChatModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetUserId  String?
  createdAt     DateTime        @default(now())

  @@index([liveSessionId])
  @@index([moderatorId])
  @@index([createdAt])
}

model LivePrayerRequest {
  id            String           @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  submitterId   String?
  submitter     User?            @relation("LivePrayerSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  name          String?
  body          String
  isPrivate     Boolean          @default(true)
  status        LivePrayerStatus @default(pending)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([liveSessionId])
  @@index([status])
  @@index([isPrivate])
  @@index([createdAt])
}

model LiveAttendance {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorKey    String?
  checkedInAt   DateTime    @default(now())

  @@unique([liveSessionId, userId])
  @@unique([liveSessionId, visitorKey])
  @@index([liveSessionId])
  @@index([userId])
  @@index([checkedInAt])
}

model LiveReaction {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorKey    String?
  emoji         String
  createdAt     DateTime    @default(now())

  @@index([liveSessionId])
  @@index([createdAt])
  @@index([emoji])
}

model LivePoll {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  question      String
  isActive      Boolean     @default(false)
  closedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  options   LivePollOption[]
  responses LivePollResponse[]

  @@index([liveSessionId])
  @@index([isActive])
}

model LivePollOption {
  id        String   @id @default(cuid())
  pollId    String
  poll      LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)

  responses LivePollResponse[]

  @@index([pollId])
}

model LivePollResponse {
  id         String         @id @default(cuid())
  pollId     String
  poll       LivePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId   String
  option     LivePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorKey String?
  createdAt  DateTime       @default(now())

  @@unique([pollId, userId])
  @@unique([pollId, visitorKey])
  @@index([pollId])
  @@index([optionId])
}

model LiveAnnouncement {
  id            String      @id @default(cuid())
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  body          String
  isPinned      Boolean     @default(false)
  authorId      String?
  author        User?       @relation("LiveAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  expiresAt     DateTime?

  @@index([liveSessionId])
  @@index([isPinned])
  @@index([createdAt])
}

// ============================================================
// Phase 34: Church Administration & Governance
// Reuses LeadershipPosition, Member, User, Ministry, Event,
// VolunteerTask, AuditLog, Notification patterns.
// ============================================================

enum GovernanceAppointmentStatus {
  active
  ended
  replaced
}

enum CommitteeStatus {
  active
  inactive
  archived
}

enum CommitteeMemberStatus {
  active
  ended
  removed
}

enum GovernanceMeetingType {
  leadership
  board
  committee
  department
  ministry
  special
  general_assembly
  custom
}

enum GovernanceMeetingStatus {
  draft
  scheduled
  in_progress
  completed
  cancelled
  postponed
}

enum AgendaItemStatus {
  proposed
  approved
  deferred
  completed
  removed
}

enum MeetingAttendanceStatus {
  invited
  present
  absent
  excused
  late
}

enum MinutesWorkflowStatus {
  draft
  secretary_review
  chair_review
  approved
  locked
  amendment_pending
}

enum DecisionStatus {
  proposed
  approved
  rejected
  deferred
  in_progress
  completed
  cancelled
}

enum ResolutionStatus {
  draft
  proposed
  approved
  rejected
  superseded
  archived
}

enum VotingMethod {
  simple_majority
  two_thirds
  unanimous
  custom
}

enum VoteChoice {
  approve
  reject
  abstain
}

enum ActionItemStatus {
  open
  in_progress
  blocked
  completed
  cancelled
}

enum PolicyWorkflowStatus {
  draft
  review
  approval
  published
  archived
}

enum DocumentAccessLevel {
  public
  member_only
  leadership_only
  committee_only
  restricted
}

enum AdminRequestStatus {
  submitted
  assigned
  under_review
  approved
  rejected
  completed
  cancelled
}

enum AdminRequestPriority {
  normal
  priority
  urgent
}

enum ApprovalEntityType {
  minutes
  policy
  resolution
  agenda
  decision
  administrative_request
  document
}

enum ApprovalStepMode {
  sequential
  parallel
}

enum ApprovalActionType {
  approve
  reject
  request_changes
  comment
  delegate
}

model GovernanceAppointment {
  id              String                       @id @default(cuid())
  positionId      String
  position        LeadershipPosition           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  memberId        String
  member          Member                       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  startAt         DateTime
  endAt           DateTime?
  status          GovernanceAppointmentStatus  @default(active)
  replacedById    String?
  replacedBy      GovernanceAppointment?       @relation("AppointmentReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacements    GovernanceAppointment[]      @relation("AppointmentReplacement")
  organizationLabel String?
  notes           String?
  appointedById   String?
  appointedBy     User?                        @relation("GovernanceAppointedBy", fields: [appointedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([positionId])
  @@index([memberId])
  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([appointedById])
}

model Committee {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String?
  responsibilities    String?
  ministryId          String?
  ministry            Ministry?       @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  chairUserId         String?
  chairUser           User?           @relation("CommitteeChair", fields: [chairUserId], references: [id], onDelete: SetNull)
  secretaryUserId     String?
  secretaryUser       User?           @relation("CommitteeSecretary", fields: [secretaryUserId], references: [id], onDelete: SetNull)
  status              CommitteeStatus @default(active)
  quorumCount         Int?
  quorumPercent       Int?
  termMonths          Int?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  members             CommitteeMember[]
  meetings            GovernanceMeeting[]
  documents           GovernanceDocument[]
  decisions           GovernanceDecision[]
  actionItems         GovernanceActionItem[]
  policies            GovernancePolicy[]

  @@index([ministryId])
  @@index([status])
  @@index([isActive])
  @@index([chairUserId])
  @@index([secretaryUserId])
}

model CommitteeMember {
  id           String                @id @default(cuid())
  committeeId  String
  committee    Committee             @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleLabel    String                @default("member")
  startAt      DateTime              @default(now())
  endAt        DateTime?
  status       CommitteeMemberStatus @default(active)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([committeeId, memberId])
  @@index([memberId])
  @@index([status])
  @@index([committeeId, status])
}

model GovernanceMeeting {
  id                     String                   @id @default(cuid())
  title                  String
  meetingType            GovernanceMeetingType    @default(committee)
  status                 GovernanceMeetingStatus  @default(draft)
  committeeId            String?
  committee              Committee?               @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  ministryId             String?
  ministry               Ministry?                @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  eventId                String?
  event                  Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  startsAt               DateTime
  endsAt                 DateTime?
  location               String?
  onlineUrl              String?
  chairUserId            String?
  chairUser              User?                    @relation("MeetingChair", fields: [chairUserId], references: [id], onDelete: SetNull)
  secretaryUserId        String?
  secretaryUser          User?                    @relation("MeetingSecretary", fields: [secretaryUserId], references: [id], onDelete: SetNull)
  agendaLocked           Boolean                  @default(false)
  quorumCount            Int?
  quorumPercent          Int?
  autoValidateLegal      Boolean                  @default(false)
  votingMethod           VotingMethod?
  votingCustomRule       String?
  votingClosed           Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  agendaItems            AgendaItem[]
  participants           MeetingParticipant[]
  minutes                MeetingMinute[]
  decisions              GovernanceDecision[]
  resolutions            Resolution[]
  votes                  GovernanceVote[]
  actionItems            GovernanceActionItem[]

  @@index([committeeId])
  @@index([ministryId])
  @@index([eventId])
  @@index([startsAt])
  @@index([status])
  @@index([meetingType])
  @@index([chairUserId])
}

model AgendaItem {
  id            String           @id @default(cuid())
  meetingId     String
  meeting       GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  presenterId   String?
  presenter     User?            @relation("AgendaPresenter", fields: [presenterId], references: [id], onDelete: SetNull)
  priority      Int              @default(0)
  sortOrder     Int              @default(0)
  durationMin   Int?
  status        AgendaItemStatus @default(proposed)
  attachmentUrl String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  decisions     GovernanceDecision[]

  @@index([meetingId])
  @@index([meetingId, sortOrder])
  @@index([status])
}

model MeetingParticipant {
  id          String                  @id @default(cuid())
  meetingId   String
  meeting     GovernanceMeeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?                 @relation(fields: [memberId], references: [id], onDelete: SetNull)
  userId      String?
  displayName String?
  attendance  MeetingAttendanceStatus @default(invited)
  isEligible  Boolean                 @default(true)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  votes       GovernanceVote[]

  @@unique([meetingId, memberId])
  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([attendance])
}

model MeetingMinute {
  id              String                @id @default(cuid())
  meetingId       String
  meeting         GovernanceMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  version         Int                   @default(1)
  summary         String?
  discussionNotes String?
  status          MinutesWorkflowStatus @default(draft)
  authorId        String?
  author          User?                 @relation("MinuteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  lockedAt        DateTime?
  amendmentOfId   String?
  amendmentOf     MeetingMinute?        @relation("MinuteAmendment", fields: [amendmentOfId], references: [id], onDelete: SetNull)
  amendments      MeetingMinute[]       @relation("MinuteAmendment")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([meetingId, version])
  @@index([meetingId])
  @@index([status])
  @@index([authorId])
}

model GovernanceDecision {
  id             String         @id @default(cuid())
  meetingId      String?
  meeting        GovernanceMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  agendaItemId   String?
  agendaItem     AgendaItem?    @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  committeeId    String?
  committee      Committee?     @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  decisionDate   DateTime       @default(now())
  status         DecisionStatus @default(proposed)
  createdById    String?
  createdBy      User?          @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  actionItems    GovernanceActionItem[]

  @@index([meetingId])
  @@index([committeeId])
  @@index([status])
  @@index([decisionDate])
}

model Resolution {
  id               String           @id @default(cuid())
  resolutionNumber String           @unique
  title            String
  description      String?
  meetingId        String?
  meeting          GovernanceMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  status           ResolutionStatus @default(draft)
  decidedAt        DateTime?
  createdById      String?
  createdBy        User?            @relation("ResolutionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  votes            GovernanceVote[]
  documents        GovernanceDocument[]

  @@index([meetingId])
  @@index([status])
  @@index([decidedAt])
}

model GovernanceVote {
  id            String              @id @default(cuid())
  meetingId     String
  meeting       GovernanceMeeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  resolutionId  String?
  resolution    Resolution?         @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  participantId String?
  participant   MeetingParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  voterUserId   String
  voter         User                @relation("VoteCaster", fields: [voterUserId], references: [id], onDelete: Cascade)
  choice        VoteChoice
  isPrivate     Boolean             @default(false)
  createdAt     DateTime            @default(now())

  @@unique([meetingId, resolutionId, voterUserId])
  @@index([meetingId])
  @@index([resolutionId])
  @@index([voterUserId])
}

model GovernanceActionItem {
  id              String          @id @default(cuid())
  title           String
  description     String?
  meetingId       String?
  meeting         GovernanceMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  decisionId      String?
  decision        GovernanceDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  committeeId     String?
  committee       Committee?      @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  ownerMemberId   String?
  ownerMember     Member?         @relation("ActionItemOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  assigneeUserId  String?
  assigneeUser    User?           @relation("ActionItemAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  volunteerTaskId String?         @unique
  volunteerTask   VolunteerTask?  @relation(fields: [volunteerTaskId], references: [id], onDelete: SetNull)
  dueAt           DateTime?
  priority        Int             @default(0)
  status          ActionItemStatus @default(open)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([meetingId])
  @@index([committeeId])
  @@index([assigneeUserId])
  @@index([status])
  @@index([dueAt])
}

model GovernancePolicy {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  description  String?
  committeeId  String?
  committee    Committee?           @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  status       PolicyWorkflowStatus @default(draft)
  authorId     String?
  author       User?                @relation("PolicyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  requireAck   Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  versions     PolicyVersion[]
  documents    GovernanceDocument[]

  @@index([committeeId])
  @@index([status])
  @@index([authorId])
}

model PolicyVersion {
  id            String               @id @default(cuid())
  policyId      String
  policy        GovernancePolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version       Int
  body          String
  status        PolicyWorkflowStatus @default(draft)
  authorId      String?
  author        User?                @relation("PolicyVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, version])
  @@index([policyId])
  @@index([status])
}

model PolicyAcknowledgement {
  id              String        @id @default(cuid())
  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  memberId        String?
  member          Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  userId          String
  acknowledgedAt  DateTime      @default(now())
  status          String        @default("acknowledged")

  @@unique([policyVersionId, userId])
  @@index([memberId])
  @@index([userId])
}

model GovernanceDocument {
  id            String              @id @default(cuid())
  title         String
  description   String?
  fileKey       String
  mimeType      String?
  sizeBytes     Int?
  version       Int                 @default(1)
  accessLevel   DocumentAccessLevel @default(restricted)
  committeeId   String?
  committee     Committee?          @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  policyId      String?
  policy        GovernancePolicy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  resolutionId  String?
  resolution    Resolution?         @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  meetingId     String?
  uploadedById  String?
  uploadedBy    User?               @relation("GovernanceDocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([committeeId])
  @@index([policyId])
  @@index([resolutionId])
  @@index([accessLevel])
  @@index([meetingId])
}

model AdminRequestCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  slaHours    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    AdministrativeRequest[]

  @@index([isActive])
}

model AdministrativeRequest {
  id              String              @id @default(cuid())
  categoryId      String
  category        AdminRequestCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberId        String
  member          Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title           String
  description     String
  status          AdminRequestStatus  @default(submitted)
  priority        AdminRequestPriority @default(normal)
  assigneeUserId  String?
  assigneeUser    User?               @relation("AdminRequestAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignedMinistryId String?
  assignedCommitteeId String?
  responseDueAt   DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  notes           AdminRequestNote[]

  @@index([categoryId])
  @@index([memberId])
  @@index([status])
  @@index([assigneeUserId])
  @@index([priority])
}

model AdminRequestNote {
  id         String                @id @default(cuid())
  requestId  String
  request    AdministrativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                  @relation("AdminRequestNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  isInternal Boolean               @default(false)
  createdAt  DateTime              @default(now())

  @@index([requestId])
  @@index([authorId])
  @@index([isInternal])
}

model ApprovalWorkflow {
  id          String             @id @default(cuid())
  name        String
  entityType  ApprovalEntityType
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  steps       ApprovalStep[]
  actions     ApprovalAction[]
  delegations ApprovalDelegation[]

  @@index([entityType])
  @@index([isActive])
}

model ApprovalStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int              @default(0)
  mode         ApprovalStepMode @default(sequential)
  requiredCount Int             @default(1)
  roleSlug     String?
  deadlineHours Int?
  createdAt    DateTime         @default(now())

  actions      ApprovalAction[]

  @@index([workflowId])
  @@index([workflowId, sortOrder])
}

model ApprovalAction {
  id           String             @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId       String?
  step         ApprovalStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  entityType   ApprovalEntityType
  entityId     String
  actorId      String
  actor        User               @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Cascade)
  action       ApprovalActionType
  comment      String?
  createdAt    DateTime           @default(now())

  @@unique([entityType, entityId, stepId, actorId, action])
  @@index([workflowId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model ApprovalDelegation {
  id           String           @id @default(cuid())
  workflowId   String?
  workflow     ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  fromUserId   String
  fromUser     User             @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User             @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  scope        String?
  startAt      DateTime         @default(now())
  endAt        DateTime?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([isActive])
  @@index([startAt, endAt])
}

model GovernanceSetting {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 String
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}
